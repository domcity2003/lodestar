
void SetSec( string wid, int i, double span, double rc, double tc, double sweep, double sloc, double dih, double tw, int tess )
{
    SetDriverGroup( wid, i, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
    string g = "XSec_" + i;
    SetParmVal( wid, "Span", g, span );
    SetParmVal( wid, "Root_Chord", g, rc );
    SetParmVal( wid, "Tip_Chord", g, tc );
    SetParmVal( wid, "Sweep", g, sweep );
    SetParmVal( wid, "Sweep_Location", g, sloc );
    SetParmVal( wid, "Dihedral", g, dih );
    SetParmVal( wid, "Twist", g, tw );
    SetParmVal( wid, "Twist_Location", g, 0.25 );
    SetParmVal( wid, "SectTess_U", g, tess );
    Update();
}

void main()
{
    //==== Wing: root, elevon break, tip, winglet ====//
    string w = AddGeom( "WING", "" );
    SetGeomName( w, "Wing" );
    InsertXSec( w, 1, XS_FILE_AIRFOIL );
    InsertXSec( w, 2, XS_FOUR_SERIES );
    Update();
    SetSec( w, 1, 0.45000, 0.59113, 0.49360, 25.0, 0.25, 0.0, -0.9000, 8 );
    SetSec( w, 2, 1.05000, 0.49360, 0.26601, 25.0, 0.25, 0.0, -3.0000, 16 );
    SetSec( w, 3, 0.25000, 0.26601, 0.15961, 35.0, 0.0, 90.0, -3.0000, 6 );
    SetParmVal( w, "RotateAirfoilMatchDideralFlag", "WingGeom", 1.0 );
    SetParmVal( w, "Tess_W", "Shape", 33 );
    string ws = GetXSecSurf( w, 0 );
    for ( int i = 0; i <= 2; i++ )
    {
        ChangeXSecShape( ws, i, XS_FILE_AIRFOIL );
        ReadFileAirfoil( GetXSec( ws, i ), "mh45.dat" );
    }
    ChangeXSecShape( ws, 3, XS_FOUR_SERIES );
    SetParmVal( GetXSecParm( GetXSec( ws, 3 ), "ThickChord" ), 0.08 );
    SetParmVal( GetXSecParm( GetXSec( ws, 3 ), "Camber" ), 0.0 );
    Update();

    //==== Centre pod (kit bay, avionics, motor mount) ====//
    string f = AddGeom( "FUSELAGE", "" );
    SetGeomName( f, "Pod" );
    SetParmVal( f, "Length", "Design", 0.82 );
    SetParmVal( f, "X_Rel_Location", "XForm", -0.17 );
    SetParmVal( f, "Z_Rel_Location", "XForm", -0.035 );
    string fs = GetXSecSurf( f, 0 );
    InsertXSec( f, 1, XS_ROUNDED_RECTANGLE );
    InsertXSec( f, 1, XS_ROUNDED_RECTANGLE );
    Update();

    ChangeXSecShape( fs, 1, XS_ROUNDED_RECTANGLE );
    SetParmVal( GetXSecParm( GetXSec( fs, 1 ), "XLocPercent" ), 0.08 );
    SetParmVal( GetXSecParm( GetXSec( fs, 1 ), "RoundedRect_Width" ), 0.09 );
    SetParmVal( GetXSecParm( GetXSec( fs, 1 ), "RoundedRect_Height" ), 0.08 );
    SetParmVal( GetXSecParm( GetXSec( fs, 1 ), "RoundRectXSec_Radius" ), 0.035 );
    SetParmVal( GetXSecParm( GetXSec( fs, 1 ), "SectTess_U" ), 6 );

    ChangeXSecShape( fs, 2, XS_ROUNDED_RECTANGLE );
    SetParmVal( GetXSecParm( GetXSec( fs, 2 ), "XLocPercent" ), 0.25 );
    SetParmVal( GetXSecParm( GetXSec( fs, 2 ), "RoundedRect_Width" ), 0.16 );
    SetParmVal( GetXSecParm( GetXSec( fs, 2 ), "RoundedRect_Height" ), 0.15 );
    SetParmVal( GetXSecParm( GetXSec( fs, 2 ), "RoundRectXSec_Radius" ), 0.04 );
    SetParmVal( GetXSecParm( GetXSec( fs, 2 ), "SectTess_U" ), 6 );

    ChangeXSecShape( fs, 3, XS_ROUNDED_RECTANGLE );
    SetParmVal( GetXSecParm( GetXSec( fs, 3 ), "XLocPercent" ), 0.6 );
    SetParmVal( GetXSecParm( GetXSec( fs, 3 ), "RoundedRect_Width" ), 0.16 );
    SetParmVal( GetXSecParm( GetXSec( fs, 3 ), "RoundedRect_Height" ), 0.15 );
    SetParmVal( GetXSecParm( GetXSec( fs, 3 ), "RoundRectXSec_Radius" ), 0.04 );
    SetParmVal( GetXSecParm( GetXSec( fs, 3 ), "SectTess_U" ), 6 );

    ChangeXSecShape( fs, 4, XS_ROUNDED_RECTANGLE );
    SetParmVal( GetXSecParm( GetXSec( fs, 4 ), "XLocPercent" ), 0.85 );
    SetParmVal( GetXSecParm( GetXSec( fs, 4 ), "RoundedRect_Width" ), 0.16 );
    SetParmVal( GetXSecParm( GetXSec( fs, 4 ), "RoundedRect_Height" ), 0.15 );
    SetParmVal( GetXSecParm( GetXSec( fs, 4 ), "RoundRectXSec_Radius" ), 0.04 );
    SetParmVal( GetXSecParm( GetXSec( fs, 4 ), "SectTess_U" ), 6 );

    ChangeXSecShape( fs, 5, XS_ROUNDED_RECTANGLE );
    SetParmVal( GetXSecParm( GetXSec( fs, 5 ), "XLocPercent" ), 0.95 );
    SetParmVal( GetXSecParm( GetXSec( fs, 5 ), "RoundedRect_Width" ), 0.09 );
    SetParmVal( GetXSecParm( GetXSec( fs, 5 ), "RoundedRect_Height" ), 0.08 );
    SetParmVal( GetXSecParm( GetXSec( fs, 5 ), "RoundRectXSec_Radius" ), 0.03 );
    SetParmVal( GetXSecParm( GetXSec( fs, 5 ), "SectTess_U" ), 6 );

    SetParmVal( f, "Tess_W", "Shape", 25 );
    Update();

    //==== Camera gimbal ball ====//
    string gb = AddGeom( "POD", "" );
    SetGeomName( gb, "Gimbal" );
    SetParmVal( gb, "Length", "Design", 0.1 );
    SetParmVal( gb, "FineRatio", "Design", 1.0 );
    SetParmVal( gb, "X_Rel_Location", "XForm", 0.02 );
    SetParmVal( gb, "Z_Rel_Location", "XForm", -0.12 );
    Update();

    WriteVSPFile( "lodestar.vsp3", SET_ALL );
    ExportFile( "lodestar.stl", SET_ALL, EXPORT_STL );
    Print( "SAVED" );

        SetSetFlag( w, 3, true );
    SetSetFlag( f, 4, true );
    SetSetFlag( gb, 4, true );
    Update();
    SetAnalysisInputDefaults( "VSPAEROComputeGeometry" );
    SetIntAnalysisInput( "VSPAEROComputeGeometry", "GeomSet", array<int> = { 4 } );
    SetIntAnalysisInput( "VSPAEROComputeGeometry", "ThinGeomSet", array<int> = { 3 } );
    SetIntAnalysisInput( "VSPAEROComputeGeometry", "Symmetry", array<int> = { 0 } );
    ExecAnalysis( "VSPAEROComputeGeometry" );
    string a = "VSPAEROSweep";
    SetAnalysisInputDefaults( a );
    SetIntAnalysisInput( a, "GeomSet", array<int> = { 4 } );
    SetIntAnalysisInput( a, "ThinGeomSet", array<int> = { 3 } );
    SetIntAnalysisInput( a, "Symmetry", array<int> = { 0 } );
    SetIntAnalysisInput( a, "RefFlag", array<int> = { 0 } );
    SetDoubleAnalysisInput( a, "Sref", array<double> = { 1.28565 } );
    SetDoubleAnalysisInput( a, "cref", array<double> = { 0.44910 } );
    SetDoubleAnalysisInput( a, "bref", array<double> = { 3.0000 } );
    SetDoubleAnalysisInput( a, "Xcg", array<double> = { 0.4220 } );
    SetDoubleAnalysisInput( a, "AlphaStart", array<double> = { 5.17 } );
    SetDoubleAnalysisInput( a, "AlphaEnd", array<double> = { 5.17 } );
    SetIntAnalysisInput( a, "AlphaNpts", array<int> = { 1 } );
    SetDoubleAnalysisInput( a, "BetaStart", array<double> = { 0.0 } );
    SetDoubleAnalysisInput( a, "BetaEnd", array<double> = { 0.0 } );
    SetIntAnalysisInput( a, "BetaNpts", array<int> = { 1 } );
    SetDoubleAnalysisInput( a, "MachStart", array<double> = { 0.0571 } );
    SetIntAnalysisInput( a, "MachNpts", array<int> = { 1 } );
    SetDoubleAnalysisInput( a, "ReCref", array<double> = { 496215 } );
    SetDoubleAnalysisInput( a, "Vinf", array<double> = { 19.0 } );
    SetDoubleAnalysisInput( a, "Vref", array<double> = { 19.0 } );
    SetDoubleAnalysisInput( a, "Rho", array<double> = { 1.0049 } );
    SetIntAnalysisInput( a, "UnsteadyType", array<int> = { 1 } );
    SetIntAnalysisInput( a, "WakeNumIter", array<int> = { 5 } );
    SetIntAnalysisInput( a, "NCPU", array<int> = { 8 } );
    ExecAnalysis( a );
    Print( "VSPAERO DONE" );
    while ( GetNumTotalErrors() > 0 ) { ErrorObj err = PopLastError(); Print( "VSPERROR: " + err.GetErrorString() ); }
}
