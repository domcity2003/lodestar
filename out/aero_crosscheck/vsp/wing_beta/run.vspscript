
void SetSec( string wid, int i, double span, double rc, double tc, double sweep, double sloc, double dih, double tw, int tess )
{
    SetDriverGroup( wid, i, SPAN_WSECT_DRIVER, ROOTC_WSECT_DRIVER, TIPC_WSECT_DRIVER );
    string g = "XSec_" + i;
    SetParmVal( wid, "Span", g, span );
    SetParmVal( wid, "Root_Chord", g, rc );
    SetParmVal( wid, "Tip_Chord", g, tc );
    SetParmVal( wid, "Sweep", g, sweep );
    SetParmVal( wid, "Sweep_Location", g, sloc );
    SetParmVal( wid, "Dihedral", g, dih );
    SetParmVal( wid, "Twist", g, tw );
    SetParmVal( wid, "Twist_Location", g, 0.25 );
    SetParmVal( wid, "SectTess_U", g, tess );
    Update();
}

void main()
{
    //==== Wing: root, elevon break, tip, winglet ====//
    string w = AddGeom( "WING", "" );
    SetGeomName( w, "Wing" );
    InsertXSec( w, 1, XS_FILE_AIRFOIL );
    InsertXSec( w, 2, XS_FOUR_SERIES );
    Update();
    SetSec( w, 1, 0.45000, 0.59113, 0.49360, 25.0, 0.25, 0.0, -0.9000, 8 );
    SetSec( w, 2, 1.05000, 0.49360, 0.26601, 25.0, 0.25, 0.0, -3.0000, 16 );
    SetSec( w, 3, 0.25000, 0.26601, 0.15961, 35.0, 0.0, 90.0, -3.0000, 6 );
    SetParmVal( w, "RotateAirfoilMatchDideralFlag", "WingGeom", 1.0 );
    SetParmVal( w, "Tess_W", "Shape", 33 );
    string ws = GetXSecSurf( w, 0 );
    for ( int i = 0; i <= 2; i++ )
    {
        ChangeXSecShape( ws, i, XS_FILE_AIRFOIL );
        ReadFileAirfoil( GetXSec( ws, i ), "mh45.dat" );
    }
    ChangeXSecShape( ws, 3, XS_FOUR_SERIES );
    SetParmVal( GetXSecParm( GetXSec( ws, 3 ), "ThickChord" ), 0.08 );
    SetParmVal( GetXSecParm( GetXSec( ws, 3 ), "Camber" ), 0.0 );
    Update();

    WriteVSPFile( "lodestar.vsp3", SET_ALL );
    ExportFile( "lodestar.stl", SET_ALL, EXPORT_STL );
    Print( "SAVED" );

        SetSetFlag( w, 3, true );
    Update();
    SetAnalysisInputDefaults( "VSPAEROComputeGeometry" );
    SetIntAnalysisInput( "VSPAEROComputeGeometry", "GeomSet", array<int> = { SET_NONE } );
    SetIntAnalysisInput( "VSPAEROComputeGeometry", "ThinGeomSet", array<int> = { 3 } );
    SetIntAnalysisInput( "VSPAEROComputeGeometry", "Symmetry", array<int> = { 0 } );
    ExecAnalysis( "VSPAEROComputeGeometry" );
    string a = "VSPAEROSweep";
    SetAnalysisInputDefaults( a );
    SetIntAnalysisInput( a, "GeomSet", array<int> = { SET_NONE } );
    SetIntAnalysisInput( a, "ThinGeomSet", array<int> = { 3 } );
    SetIntAnalysisInput( a, "Symmetry", array<int> = { 0 } );
    SetIntAnalysisInput( a, "RefFlag", array<int> = { 0 } );
    SetDoubleAnalysisInput( a, "Sref", array<double> = { 1.28565 } );
    SetDoubleAnalysisInput( a, "cref", array<double> = { 0.44910 } );
    SetDoubleAnalysisInput( a, "bref", array<double> = { 3.0000 } );
    SetDoubleAnalysisInput( a, "Xcg", array<double> = { 0.4220 } );
    SetDoubleAnalysisInput( a, "AlphaStart", array<double> = { 5.17 } );
    SetDoubleAnalysisInput( a, "AlphaEnd", array<double> = { 5.17 } );
    SetIntAnalysisInput( a, "AlphaNpts", array<int> = { 1 } );
    SetDoubleAnalysisInput( a, "BetaStart", array<double> = { -2.0 } );
    SetDoubleAnalysisInput( a, "BetaEnd", array<double> = { 2.0 } );
    SetIntAnalysisInput( a, "BetaNpts", array<int> = { 3 } );
    SetDoubleAnalysisInput( a, "MachStart", array<double> = { 0.0571 } );
    SetIntAnalysisInput( a, "MachNpts", array<int> = { 1 } );
    SetDoubleAnalysisInput( a, "ReCref", array<double> = { 496215 } );
    SetDoubleAnalysisInput( a, "Vinf", array<double> = { 19.0 } );
    SetDoubleAnalysisInput( a, "Vref", array<double> = { 19.0 } );
    SetDoubleAnalysisInput( a, "Rho", array<double> = { 1.0049 } );
    SetIntAnalysisInput( a, "UnsteadyType", array<int> = { 0 } );
    SetIntAnalysisInput( a, "WakeNumIter", array<int> = { 5 } );
    SetIntAnalysisInput( a, "NCPU", array<int> = { 8 } );
    ExecAnalysis( a );
    Print( "VSPAERO DONE" );
    while ( GetNumTotalErrors() > 0 ) { ErrorObj err = PopLastError(); Print( "VSPERROR: " + err.GetErrorString() ); }
}
